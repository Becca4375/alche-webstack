global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    bind *:443 ssl crt /etc/haproxy/certs/www.ihirwe.tech.pem
    default_backend web_servers

backend web_servers
    balance roundrobin
    server web-01 100.58.119.5:80 check
    server web-02 44.203.251.121:80 check
